# -----------------------------------------------------------------------------
# PEPLAB — client environment variables
#
# 1. Copy this file to `.env` (git-ignored) and fill in real values.
# 2. Set the same variables in Vercel → Project Settings → Environment Variables
#    for every environment you deploy to (Production, Preview, Development).
#
# Reminder: anything prefixed VITE_ is EMBEDDED IN THE CLIENT BUNDLE and
# visible to anyone who inspects the built JS. Never put a real secret behind
# a VITE_ variable — real secrets belong in Supabase Edge Function secrets
# (server-side), and the client should call the edge function.
# -----------------------------------------------------------------------------

# --- Supabase (required) ------------------------------------------------------
# These are safe to publish; the anon key has "role":"anon" baked in and is
# protected by Row Level Security on the DB. The service_role key must NEVER
# appear in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Deployment: peplab.com.au (THIS project) -------------------------------
# Separate Vercel project for peplab.ai — use the peplab-ai repo (sibling copy).
#
# peplab.com.au → login entry + public SEO; shop after sign-in on this domain
# peplab.ai     → open storefront (separate Vercel project / peplab-ai repo)
#
# Vercel: attach peplab.com.au + www.peplab.com.au ONLY to this project.
VITE_SITE_URL=https://peplab.com.au
VITE_MAIN_APP_ORIGIN=https://peplab.ai
# Optional override for landing-page absolute URLs (defaults to origin/landing).
# VITE_LANDING_SITE_URL=https://peplab.com.au/landing
#
# Lock peplab.com.au to login-only. Shop now button links to VITE_MAIN_APP_ORIGIN (.ai).
VITE_LOGIN_ONLY_HOSTS=peplab.com.au,www.peplab.com.au

# --- Email --------------------------------------------------------------------
# The email send path in production is the Supabase Edge Function `send-email`.
# Its RESEND_API_KEY, RESEND_FROM_EMAIL, and optional RESEND_FROM_NAME all live
# in Supabase → Edge Functions → Secrets (server-side). NEITHER should appear
# here as a VITE_* variable, or the values will land in the client bundle.
#
# Production sender (set in Supabase secrets, NOT here):
#   RESEND_FROM_EMAIL = noreply@peplab.ai          (checkout, payment, shipping — leave this)
#   RESEND_FROM_NAME  = PEPLAB
#   RESEND_REVIEW_FROM_EMAIL = contact@peplab.ai   (Trustpilot review emails only)
#   RESEND_MARKETING_FROM_EMAIL = hello@peplab.com.au  (optional; promo allowlist only)
# One-off marketing (PEP50) is sent from the Resend dashboard using a verified
# @peplab.com.au domain. Do not change RESEND_FROM_EMAIL to .com.au.
#
# The variables below are DEV-ONLY fallbacks used by the local Vite proxy
# when the edge function is not yet deployed. Leave them commented out /
# blank in every deployed environment.
# VITE_RESEND_API_KEY=
# VITE_FROM_EMAIL=PEPLAB <noreply@peplab.ai>
# VITE_REVIEW_FROM_EMAIL=PEPLAB <contact@peplab.ai>
# Set to true to render email HTML from the Supabase `email_templates` table
# instead of the hardcoded branded templates in src/lib/email.ts.
# VITE_EMAIL_USE_SUPABASE_HTML_TEMPLATES=false

# --- Australia Post Shipping API (labels + tracking) --------------------------
# Production path is the Supabase Edge Function `auspost-create-label`.
# Put ALL of these in Supabase → Edge Functions → Secrets (NOT as VITE_*):
#
#   AUSPOST_API_KEY=ba66d41a-...          (from AusPost welcome pack)
#   AUSPOST_API_PASSWORD=...
#   AUSPOST_ACCOUNT_NUMBER=2005401703    (domestic test account)
#   AUSPOST_BASE_URL=https://digitalapi.auspost.com.au/test/shipping/v1
#   AUSPOST_PRODUCT_ID_EXPRESS=           (optional — auto-picked from Get Accounts)
#   AUSPOST_PRODUCT_ID_STANDARD=          (optional — auto-picked from Get Accounts)
#   AUSPOST_FROM_NAME=PEPLAB Australia
#   AUSPOST_FROM_LINES=Your real street address
#   AUSPOST_FROM_SUBURB=SYDNEY            (must match postcode — e.g. SYDNEY + 2000)
#   AUSPOST_FROM_STATE=NSW
#   AUSPOST_FROM_POSTCODE=2000
#   AUSPOST_FROM_PHONE=
#   AUSPOST_FROM_EMAIL=
#
# Tip: suburb/state/postcode must be a real AusPost locality match (both FROM secrets
# and the customer address on the order). Product IDs are loaded from Get Accounts
# on each label create — do not hardcode production IDs on the testbed.
# Checkout validates suburb/state/postcode via Edge Function `auspost-validate-address`
# (same secrets as auspost-create-label). Deploy that function after pulling this change.
#
# Auto-mark Delivered (Track Items API) — Edge Function `auspost-sync-delivered`:
#   AUSPOST_SYNC_CRON_SECRET=long-random-string   (for scheduled HTTP calls)
#   TRUSTPILOT_REVIEW_URL=https://www.trustpilot.com/evaluate/peplab.com.au  (optional)
# Deploy: supabase functions deploy auspost-sync-delivered
# Schedule every few hours (Supabase Dashboard → Edge Functions → Schedules) OR:
#   curl -X POST "$SUPABASE_URL/functions/v1/auspost-sync-delivered" \
#     -H "x-cron-secret: $AUSPOST_SYNC_CRON_SECRET"
# Admin Orders also has “Sync AusPost deliveries” (uses admin JWT).
#
# Public Track Order live AusPost events — Edge Function `auspost-track-public`
# (same AusPost secrets; verify_jwt=false; ownership via track_order RPC).
# Deploy: supabase functions deploy auspost-track-public
#
# Legacy client postage placeholders (unused by label creation — do not put secrets here):
# VITE_AUSPOST_API_KEY=
# VITE_AUSPOST_API_SECRET=

# --- Research AI (admin CMS) --------------------------------------------------
# Edge Function `research-ai-parse` turns pasted/uploaded docs into research
# article fields (headings, body, FAQs, etc.). Keep the key SERVER-SIDE only:
#   Supabase → Edge Functions → Secrets → OPENAI_API_KEY=sk-...
# Optional: OPENAI_MODEL=gpt-4o-mini
# Deploy: supabase functions deploy research-ai-parse
# Never set VITE_OPENAI_API_KEY — it would ship in the browser bundle.

# --- Feature flags ------------------------------------------------------------
# Trustpilot — homepage uses Supabase sync (admin Sync), not live widgets.
# Edge Function secrets (Supabase): APIFY_TOKEN, optional APIFY_TRUSTPILOT_ACTOR_ID,
# TRUSTPILOT_PROFILE_URL=https://www.trustpilot.com/review/peplab.com.au
# Optional legacy TrustBox IDs (unused by homepage slider):
# VITE_TRUSTPILOT_BUSINESS_UNIT_ID=
# VITE_TRUSTPILOT_WIDGET_TOKEN=
#
# First-visit welcome popup.
# VITE_ENABLE_SIGNUP_WELCOME_MODAL=true
# Blur COA PDF previews in the certificate dialog.
# VITE_COA_PDF_BLURRED=true
