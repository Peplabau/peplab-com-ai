{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.peplab.com.au"
        }
      ],
      "destination": "https://peplab.com.au/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.peplab.com.au"
        }
      ],
      "destination": "https://peplab.com.au/:path*",
      "statusCode": 301
    },
    {
      "source": "/product/retatrutide",
      "destination": "/product/reta",
      "permanent": true
    },
    {
      "source": "/product/semaglutide",
      "destination": "/product/Semaglutide",
      "permanent": true
    },
    {
      "source": "/product/bacteriostatic-water",
      "destination": "/product/bac-water",
      "permanent": true
    },
    {
      "source": "/product/tb500",
      "destination": "/product/tb-500",
      "permanent": true
    },
    {
      "source": "/product/hgh",
      "destination": "/product/hgh-191aa",
      "permanent": true
    },
    {
      "source": "/product/epithalon",
      "destination": "/product/epitalon",
      "permanent": true
    },
    {
      "source": "/product/bpc-tb-combo",
      "destination": "/product/bpc-5mg-tb-5mg",
      "permanent": true
    },
    {
      "source": "/product/bpc-157-tb500",
      "destination": "/product/bpc-5mg-tb-5mg",
      "permanent": true
    },
    {
      "source": "/product/bpc-157-tb-500",
      "destination": "/product/bpc-5mg-tb-5mg",
      "permanent": true
    },
    {
      "source": "/product/gsh-glutathione",
      "destination": "/product/glutathione",
      "permanent": true
    },
    {
      "source": "/product/melanotan-ii",
      "destination": "/product/mt-2",
      "permanent": true
    },
    {
      "source": "/product/syringes-1ml-31g",
      "destination": "/product/1ml-31g-6mm-syringes",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.peplab.ai" }],
      "destination": "https://peplab.ai/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.peplab.ai" }],
      "destination": "https://peplab.ai/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "peplab.ai" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.peplab.ai" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "peplab.ai" }],
      "destination": "/robots-ai.txt"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "www.peplab.ai" }],
      "destination": "/robots-ai.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "peplab.ai" }],
      "destination": "/sitemap-ai.xml"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "www.peplab.ai" }],
      "destination": "/sitemap-ai.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}